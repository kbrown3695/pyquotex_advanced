    "9_access_patterns": {
      "to_get_account_balance": [
        "1. Call: await client.get_balance()",
        "2. Access: client.api.account_balance['demoBalance']",
        "Returns: float (10000.0 for demo)"
      ],
      "to_get_realtime_candles": [
        "1. Call: await client.subscribe_realtime_candle('EURUSD_otc', 60)",
        "2. Wait: await asyncio.sleep(1)",
        "3. Access: client.api.wss_message",
        "Returns: dict with 'asset', 'period', 'history'"
      ],
      "to_get_profile": [
        "1. Call: await client.get_balance() (populates profile)",
        "2. Access: client.api.profile.demo_balance",
        "3. Or: client.api.profile.currency_code",
        "Returns: attribute values from Profile object"
      ]
